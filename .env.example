# Copy this file to `.env` (which is git-ignored) and fill in your key.
# Used by the dev server's audio-regenerate endpoint and `npm run audio`.

OPENAI_API_KEY=sk-your-key-here

# Optional overrides:
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy

# Shared global high score (Supabase).
# Project Settings → API: copy the Project URL and the service_role key.
# The service_role key is secret — server-side only, never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
